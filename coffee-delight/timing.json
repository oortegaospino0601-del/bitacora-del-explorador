{"SC": [0, 2.043, 5.623, 11.973, 15.698, 19.298, 22.229, 26.205, 31.205, 35.806, 38.2], "VO": [0.05, 2.163, 5.743, 12.093, 15.818, 19.418, 22.349, 26.325, 31.325, 35.926], "SUBS": [{"a": 0.05, "b": 1.183, "text": "Mi natilla de este año"}, {"a": 1.183, "b": 2.163, "text": "sabe a café."}, {"a": 2.163, "b": 3.118, "text": "Y el truco lo compré"}, {"a": 3.118, "b": 4.364, "text": "en la tienda de la esquina:"}, {"a": 4.364, "b": 5.743, "text": "Coffee Delight Clásico."}, {"a": 5.743, "b": 6.825, "text": "En la olla van tres"}, {"a": 6.825, "b": 8.251, "text": "cuartos de litro de leche,"}, {"a": 8.251, "b": 9.432, "text": "150 gramos de panela,"}, {"a": 9.432, "b": 10.711, "text": "dos astillas de canela…"}, {"a": 10.711, "b": 12.093, "text": "y veinte caramelos."}, {"a": 12.093, "b": 12.84, "text": "A fuego medio,"}, {"a": 12.84, "b": 13.498, "text": "revolviendo,"}, {"a": 13.498, "b": 14.64, "text": "hasta que se disuelvan."}, {"a": 14.64, "b": 15.818, "text": "¡Miren ese color!"}, {"a": 15.818, "b": 16.311, "text": "Aparte,"}, {"a": 16.311, "b": 17.446, "text": "el resto de la leche"}, {"a": 17.446, "b": 19.418, "text": "fría con 120 gramos de fécula."}, {"a": 19.418, "b": 19.917, "text": "Lo echo,"}, {"a": 19.917, "b": 21.096, "text": "y a revolver sin parar,"}, {"a": 21.096, "b": 22.349, "text": "unos diez minutos."}, {"a": 22.349, "b": 23.701, "text": "Cuando se despega de la olla,"}, {"a": 23.701, "b": 24.293, "text": "está lista:"}, {"a": 24.293, "b": 24.927, "text": "mantequilla,"}, {"a": 24.927, "b": 26.325, "text": "al molde y a la nevera."}, {"a": 26.325, "b": 27.275, "text": "Y el toque final:"}, {"a": 27.275, "b": 28.7, "text": "trituro seis caramelos y se"}, {"a": 28.7, "b": 29.839, "text": "los riego por encima."}, {"a": 29.839, "b": 31.325, "text": "¡Eso cruje delicioso!"}, {"a": 31.325, "b": 32.202, "text": "¿Y los que sobran?"}, {"a": 32.202, "b": 32.828, "text": "Al bolsillo."}, {"a": 32.828, "b": 33.956, "text": "Café de bolsillo para mi"}, {"a": 33.956, "b": 34.874, "text": "pausa en la novena…"}, {"a": 34.874, "b": 35.926, "text": "o en el camino."}, {"a": 35.926, "b": 38.2, "text": "Guárdenla para el 16."}]}